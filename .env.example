# Flask Configuration
# These are used by the 'flask' command.
FLASK_APP=run.py
FLASK_ENV=development

# Application Configuration
# A strong, random secret key used by Flask to sign session cookies.
# You can generate one using: python -c 'import secrets; print(secrets.token_hex())'
SECRET_KEY="your_very_secret_key_here"

# Google Cloud Configuration
# The ID of your Google Cloud project.
GOOGLE_CLOUD_PROJECT="your-gcp-project-id-here"

# Your Google Maps API Key for the frontend.
# Ensure the "Maps JavaScript API" is enabled in your Google Cloud project.
GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"
