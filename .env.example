# Rename this file to .env and fill in the values for local development.
# In a production environment like Google Cloud Run, these should be set as environment variables.

# A strong, random secret key used by Flask to sign session cookies.
# You can generate one using: python -c 'import secrets; print(secrets.token_hex())'
SECRET_KEY="your_very_secret_key_here"

# Path to your Google Cloud service account JSON file.
# This file provides the credentials for the Flask app and the seed script to authenticate with Firestore.
# Make sure this file is NOT committed to version control.
GOOGLE_APPLICATION_CREDENTIALS="./service-account-key.json"

# Your Google Maps API Key for the frontend.
# Ensure the "Maps JavaScript API" and "Places API" are enabled in your Google Cloud project.
GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"
